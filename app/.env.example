# Chain RPC used by the browser (public RPC is rate-limited; use a provider URL in production)
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# WalletConnect Cloud project id (https://cloud.reown.com) - required for mobile wallets
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Public URL of the deployed app (used in share links)
NEXT_PUBLIC_APP_URL=https://stockgift.example
# Gasless relayer endpoint (scripts/relayer). Empty = claims are sent from the recipient's wallet.
NEXT_PUBLIC_RELAYER_URL=
# $GIFT project token address. EMPTY = all token features hidden.
NEXT_PUBLIC_PROJECT_TOKEN=
# Optional geoblock: comma-separated ISO country codes (uses x-vercel-ip-country)
GEOBLOCK_COUNTRIES=
# Local fork only: enables an impersonating dev wallet against anvil --auto-impersonate
NEXT_PUBLIC_DEV_WALLET=
